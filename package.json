{
  "name": "photo-metadata-queue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/write-release.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:claims": "playwright test --grep @claim:",
    "test:live": "node tests/release/verify-live.mjs",
    "test:polish-live": "node tests/release/verify-polish-4.mjs",
    "verify:release": "node scripts/verify-release-provenance.mjs",
    "verify:url": "./verify-url.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "22.13.4",
    "playwright-core": "1.58.2",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
